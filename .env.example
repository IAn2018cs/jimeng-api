# ================= Storage =================
STORAGE_TYPE=local_mount
NAS_MOUNT_PATH=/app/storage
NAS_FILE_URL_PREFIX=http://192.168.1.100:8080/videos

# ================= NAS SMB Mount (Docker volume) =================
NAS_HOST=192.168.1.100
NAS_USER=your_username
NAS_PASSWORD=your_password
NAS_PORT=445
NAS_SHARE_PATH=shared/videos

# ================= Volcengine ARK (Fallback for Seedance models) =================
ARK_API_KEY=your_ark_api_key
ARK_MODEL=doubao-seedance-2-0-260128
ARK_FAST_MODEL=doubao-seedance-2-0-fast-260128

# ================= Volcengine TOS (火山引擎对象存储，视频文件上传) =================
# 配置后火山引擎备用渠道可正确引用用户上传的视频文件
TOS_ACCESS_KEY_ID=your_tos_access_key_id
TOS_ACCESS_KEY_SECRET=your_tos_access_key_secret
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_BUCKET=your_tos_bucket_name
